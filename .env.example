# Sample application's PostgreSQL source. Ask AI does NOT query this database directly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# Microsoft Foundry / Agent Framework
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL=gpt-4.1-mini

# Optional service-principal auth. Leave blank for local AzureCliCredential + `az login`.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000
